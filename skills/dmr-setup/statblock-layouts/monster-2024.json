      ],
      "nested": [
        {
          "type": "property",
          "id": "dmr-ac",
          "properties": [
            "ac"
          ],
          "display": "AC",
          "conditioned": true,
          "callback": "if (monster.ac == null || monster.ac === \"\") return \"\";\nconst ac = [monster.ac];\nif (monster.ac_class) ac.push(\"(\" + monster.ac_class + \")\");\nreturn ac.join(\" \");"
        },
        {
          "type": "property",
          "id": "dmr-initiative",
          "properties": [
            "initiative"
          ],
          "display": "Initiative",
          "conditioned": true,
          "callback": "if (monster.initiative == null || monster.initiative === \"\") return \"\";\nconst i = Number(monster.initiative);\nif (isNaN(i)) return String(monster.initiative);\nreturn (i < 0 ? \"−\" : \"+\") + Math.abs(i) + \" (\" + (10 + i) + \")\";"
        },
        {
          "type": "property",
          "id": "dmr-hp",
          "properties": [
            "hp"
          ],
          "display": "HP",
          "conditioned": true,
          "callback": "if (monster.hp == null || monster.hp === \"\") return \"\";\nconst hp = [monster.hp];\nif (monster.hit_dice) hp.push(\"(\" + monster.hit_dice + \")\");\nreturn hp.join(\" \");",
          "dice": true,
          "diceProperty": "hit_dice",
          "diceCallback": "if (\"hit_dice\" in monster) {\n  return [{ text: monster[\"hit_dice\"] }];\n}\nreturn property;"
        },
        {
          "type": "property",
          "id": "dmr-speed",
          "properties": [
            "speed"
          ],
          "display": "Speed",
          "conditioned": true
        }
      ],
      "conditioned": true,
      "hasRule": true
    },
    {
      "type": "javascript",
      "id": "dmr-abilities",
      "properties": [
        "stats"
      ],
      "conditioned": true,
      "hasRule": true,
      "code": "const names = [t(\"Strength\"), t(\"Dexterity\"), t(\"Constitution\"), t(\"Intelligence\"), t(\"Wisdom\"), t(\"Charisma\")];\nconst short = [t(\"STR\"), t(\"DEX\"), t(\"CON\"), t(\"INT\"), t(\"WIS\"), t(\"CHA\")];\nconst el = (tag, text) => {\n  const e = document.createElement(tag);\n  if (text != null) e.textContent = String(text);\n  return e;\n};\nconst stats = Array.isArray(monster.stats) ? monster.stats : [];\nif (stats.length !== 6) return el(\"div\");\nconst saves = {};\nfor (const save of Array.isArray(monster.saves) ? monster.saves : []) {\n  if (save && typeof save === \"object\") {\n    for (const [name, value] of Object.entries(save)) saves[String(name).trim().toLowerCase()] = value;\n  }\n}\nconst signed = (n) => (n < 0 ? \"−\" : \"+\") + Math.abs(n);\nconst table = el(\"table\");\ntable.className = \"dmr-abilities\";\ntable.style.width = \"100%\";\ntable.style.textAlign = \"center\";\nconst head = el(\"tr\");\nfor (let k = 0; k < 3; k++) head.append(el(\"th\"), el(\"th\"), el(\"th\", t(\"MOD\")), el(\"th\", t(\"SAVE\")));\ntable.append(head);\nfor (const half of [[0, 1, 2], [3, 4, 5]]) {\n  const row = el(\"tr\");\n  for (const i of half) {\n    const mod = Math.floor((Number(stats[i]) - 10) / 2);\n    const listed = saves[String(names[i]).toLowerCase()];\n    const save = listed != null && !isNaN(Number(listed)) ? Number(listed) : mod;\n    const abbr = el(\"th\", short[i]);\n    row.append(abbr, el(\"td\", stats[i]), el(\"td\", signed(mod)), el(\"td\", signed(save)));\n  }\n  table.append(row);\n}\nreturn table;"
    },
